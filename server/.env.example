# BrokenRepo backend environment
# Copy to server/.env on the VM (cp .env.example .env) and fill every
# <PLACEHOLDER>. Values below marked with the Render note are the exact
# production values this service ran with on Render (exported 2026-10-11).

# MongoDB Atlas connection string (secret)
MONGODB_URI=<PLACEHOLDER_mongodb_plus_srv_connection_string>

# Mongo database name (Render note: intentionally the historical name, do not rename)
MONGODB_DB_NAME=Codebreak

# CORS allowlist, comma separated (Render note: exact production list)
CLIENT_ORIGINS=https://www.brokenrepo.tech,https://brokenrepo.tech,https://codebreak-vijay1172s-projects.vercel.app,https://project-vdd5s.vercel.app,http://localhost:3000,http://localhost:5173

# Daytona sandbox integration (secret + endpoints)
DAYTONA_API_KEY=<PLACEHOLDER_daytona_api_key>
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# HMAC secret used to sign per-session preview URLs (secret)
PREVIEW_PROXY_SECRET=<PLACEHOLDER_random_hex_secret>

# Per-session preview subdomain suffix. Keep exactly this value: the frontend
# trusts messages only from *.preview.brokenrepo.tech origins.
PREVIEW_PROXY_DOMAIN_SUFFIX=preview.brokenrepo.tech

# Session lifecycle (Render note: exact production values)
SESSION_TTL_MINUTES=30
SESSION_IDLE_MINUTES=25

# Process
NODE_ENV=production
# 5000 matches the nginx proxy_pass on this VM; the port stays localhost-only
PORT=5000
