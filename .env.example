# Server-side proxy target. Credentials remain in HttpOnly cookies.
BROKENREPO_BACKEND_URL=http://localhost:4000

# Optional coach configuration belongs on the backend (server/.env.example).
# Never configure a public Gemini key on the frontend.

# Contact form email delivery (server-side only).
RESEND_API_KEY=
BROKENREPO_SUPPORT_EMAIL=vijaysharma11702@gmail.com
# Use onboarding@resend.dev for testing, or a sender on your verified domain.
BROKENREPO_SUPPORT_FROM=BrokenRepo Support <onboarding@resend.dev>
